{
  "name": "chuer-niang",
  "version": "1.1.0",
  "type": "module",
  "description": "雏儿娘：DSH Web UI 照片桌宠，带好感度、钱包、段位、白袜和用户画像记忆。",
  "license": "MIT",
  "author": "SokiSeven",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SokiSeven/chuer-niang.git"
  },
  "homepage": "https://github.com/SokiSeven/chuer-niang#readme",
  "bugs": {
    "url": "https://github.com/SokiSeven/chuer-niang/issues"
  },
  "keywords": [
    "dsh",
    "plugin",
    "desktop-pet",
    "photo",
    "chuer-niang"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "persona.example.txt",
    "persona.enc",
    "persona-crypto.mjs",
    "scanner.mjs",
    "memory.mjs",
    "assets/*.webp",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.png",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test ../tests/*.test.mjs",
    "check": "node --check index.js && node --check scanner.mjs && node --check memory.mjs && node --check client.js"
  }
}
